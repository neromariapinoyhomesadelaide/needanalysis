+const MAX_UPLOAD_FILES = 10;
+const MAX_FILE_BYTES = 10 * 1024 * 1024;
+const ALLOWED_FILE_EXTENSIONS = ['pdf','jpg','jpeg','png','doc','docx'];
+let selectedSupportingFiles = [];
+
+function humanFileSize(bytes){
+  if (bytes < 1024) return bytes + ' B';
+  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
+  return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
+}
+
+function validateSupportingFile(file){
+  const ext = (file.name.split('.').pop() || '').toLowerCase();
+  if (!ALLOWED_FILE_EXTENSIONS.includes(ext)) return 'Unsupported file type: ' + file.name;
+  if (file.size > MAX_FILE_BYTES) return file.name + ' is larger than 10 MB.';
+  return '';
+}
+
+function addSupportingFiles(fileList){
+  const incoming = Array.from(fileList || []);
+  const errors = [];
+  incoming.forEach(file => {
+    const error = validateSupportingFile(file);
+    if (error) { errors.push(error); return; }
+    const duplicate = selectedSupportingFiles.some(f => f.name === file.name && f.size === file.size && f.lastModified === file.lastModified);
+    if (!duplicate) selectedSupportingFiles.push(file);
+  });
+  if (selectedSupportingFiles.length > MAX_UPLOAD_FILES){
+    selectedSupportingFiles = selectedSupportingFiles.slice(0, MAX_UPLOAD_FILES);
+    errors.push('A maximum of 10 files can be uploaded.');
+  }
+  renderSupportingFiles();
+  setUploadStatus(errors.join(' '), errors.length ? 'error' : '');
+}
+
+function removeSupportingFile(index){
+  selectedSupportingFiles.splice(index, 1);
+  renderSupportingFiles();
+}
+
+function renderSupportingFiles(){
+  const target = document.getElementById('fileList');
+  if (!target) return;
+  target.innerHTML = selectedSupportingFiles.map((file, index) =>
+    '<div class="file-item"><span class="file-meta">📎 ' + escapeHtml(file.name) + ' — ' + humanFileSize(file.size) + '</span>' +
+    '<button class="file-remove" type="button" onclick="removeSupportingFile(' + index + ')">Remove</button></div>'
+  ).join('');
+}
+
+function setUploadStatus(message, type){
+  const el = document.getElementById('uploadStatus');
+  if (!el) return;
+  el.textContent = message || '';
+  el.className = 'upload-status' + (type ? ' ' + type : '');
+}
+
+const supportingInput = document.getElementById('supportingDocuments');
+const fileDropZone = document.getElementById('fileDropZone');
+supportingInput?.addEventListener('change', e => { addSupportingFiles(e.target.files); e.target.value = ''; });
+['dragenter','dragover'].forEach(type => fileDropZone?.addEventListener(type, e => { e.preventDefault(); fileDropZone.classList.add('dragover'); }));
+['dragleave','drop'].forEach(type => fileDropZone?.addEventListener(type, e => { e.preventDefault(); fileDropZone.classList.remove('dragover'); }));
+fileDropZone?.addEventListener('drop', e => addSupportingFiles(e.dataTransfer.files));
